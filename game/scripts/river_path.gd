extends RefCounted
## Ось реки: плавная излучина с двумя добавочными гармониками (меандры). Единый источник для
## рельефа (main), бобров, рыб и зверей — раньше формула была вписана в пяти местах.

static func zc(x: float) -> float:
	# Фазы русла принадлежат новому общему seed карты 20261127.
	return 70.0 * sin(x / 95.0 + 0.271) + 20.0 + 18.0 * sin(x / 41.0 + 1.571) + 7.0 * sin(x / 17.0 + 0.672)

static func dzc(x: float) -> float:
	return 70.0 / 95.0 * cos(x / 95.0) + 18.0 / 41.0 * cos(x / 41.0 + 1.3) + 7.0 / 17.0 * cos(x / 17.0 + 0.4)
